LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# extractive (default, deterministic) | llm (grounded answer from the configured provider)
QA_MODE=extractive
